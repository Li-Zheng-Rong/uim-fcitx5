xkb_keymap {
    xkb_keycodes { include "evdev+aliases(qwerty)" };
    xkb_types {
        include "complete"
        type "WIN_SPACE" {
            modifiers = Mod4;
            map[None] = Level1;
            map[Mod4] = Level2;
        };
    };
    xkb_compatibility { include "complete" };
    xkb_symbols {
        include "pc+us+inet(evdev)"
        // Win+Space is transported to the UIM engine as F13.
        key <SPCE> {
            type[Group1] = "WIN_SPACE",
            symbols[Group1] = [ space, F13 ]
        };
    };
};

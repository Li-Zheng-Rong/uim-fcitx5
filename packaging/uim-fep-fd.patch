--- /dev/null
+++ b/fep/scheme-fd-watch.h
@@ -0,0 +1,162 @@
+/* Main-thread Scheme descriptor watches for native input-method plugins. */
+#ifndef UIM_FEP_SCHEME_FD_WATCH_H
+#define UIM_FEP_SCHEME_FD_WATCH_H
+
+#include <uim/uim-scm.h>
+
+enum scheme_fd_interest {
+  SCHEME_FD_READ = 1,
+  SCHEME_FD_WRITE = 2
+};
+
+struct scheme_fd_watch {
+  int fd, interest, ready, removed;
+  uim_lisp callback;
+  struct scheme_fd_watch *next, *ready_next;
+};
+static struct scheme_fd_watch *scheme_fd_watches;
+
+static void free_scheme_fd_watch(struct scheme_fd_watch *watch)
+{
+  uim_scm_gc_unprotect(&watch->callback);
+  free(watch);
+}
+
+static uim_lisp scheme_unwatch_fd(uim_lisp descriptor)
+{
+  int fd = uim_scm_c_int(descriptor);
+  struct scheme_fd_watch **link = &scheme_fd_watches;
+  while (*link) {
+    struct scheme_fd_watch *watch = *link;
+    if (watch->fd == fd) {
+      *link = watch->next;
+      /* The ready snapshot may still refer to this registration. A new
+       * registration for the same fd must not inherit its readiness. */
+      watch->removed = 1;
+      if (!watch->ready)
+        free_scheme_fd_watch(watch);
+      break;
+    }
+    link = &watch->next;
+  }
+  return uim_scm_f();
+}
+
+static uim_lisp scheme_watch_fd(uim_lisp descriptor, uim_lisp flags,
+                                uim_lisp callback)
+{
+  int fd = uim_scm_c_int(descriptor);
+  int interest = uim_scm_c_int(flags);
+  struct scheme_fd_watch *watch;
+  if (fd < 0 || fd >= FD_SETSIZE ||
+      (interest & ~(SCHEME_FD_READ | SCHEME_FD_WRITE)))
+    return uim_scm_f();
+  for (watch = scheme_fd_watches; watch; watch = watch->next) {
+    if (watch->fd == fd) {
+      /* Callback replacement is a new registration; only update-fd
+       * preserves identity and pending readiness. */
+      scheme_unwatch_fd(descriptor);
+      break;
+    }
+  }
+  watch = uim_malloc(sizeof(*watch));
+  watch->fd = fd;
+  watch->interest = interest;
+  watch->ready = watch->removed = 0;
+  watch->callback = callback;
+  watch->next = scheme_fd_watches;
+  uim_scm_gc_protect(&watch->callback);
+  scheme_fd_watches = watch;
+  return uim_scm_t();
+}
+
+static uim_lisp scheme_update_fd(uim_lisp descriptor, uim_lisp flags)
+{
+  int fd = uim_scm_c_int(descriptor);
+  int interest = uim_scm_c_int(flags);
+  struct scheme_fd_watch *watch;
+  if (interest & ~(SCHEME_FD_READ | SCHEME_FD_WRITE))
+    return uim_scm_f();
+  for (watch = scheme_fd_watches; watch; watch = watch->next) {
+    if (watch->fd == fd) {
+      watch->interest = interest;
+      return uim_scm_t();
+    }
+  }
+  return uim_scm_f();
+}
+
+static void *register_scheme_fd_watches(void *unused)
+{
+  (void)unused;
+  uim_scm_init_proc3("uim-fep-watch-fd", scheme_watch_fd);
+  uim_scm_init_proc2("uim-fep-update-fd", scheme_update_fd);
+  uim_scm_init_proc1("uim-fep-unwatch-fd", scheme_unwatch_fd);
+  return NULL;
+}
+
+static void init_scheme_fd_watches(void)
+{
+  uim_scm_call_with_gc_ready_stack(register_scheme_fd_watches, NULL);
+}
+
+static int add_scheme_fd_watches(fd_set *readfds, fd_set *writefds, int nfd)
+{
+  struct scheme_fd_watch *watch;
+  for (watch = scheme_fd_watches; watch; watch = watch->next) {
+    if (watch->interest & SCHEME_FD_READ)
+      FD_SET(watch->fd, readfds);
+    if (watch->interest & SCHEME_FD_WRITE)
+      FD_SET(watch->fd, writefds);
+    if (watch->interest && watch->fd >= nfd)
+      nfd = watch->fd + 1;
+  }
+  return nfd;
+}
+
+static int dispatch_scheme_fd_watches(fd_set *readfds, fd_set *writefds)
+{
+  struct scheme_fd_watch *watch, *ready = NULL, **tail = &ready;
+  int dispatched = 0;
+  /* Snapshot registrations, not descriptor numbers. The nodes themselves
+   * hold this temporary queue, so idle/PTY events allocate nothing. */
+  for (watch = scheme_fd_watches; watch; watch = watch->next) {
+    watch->ready =
+      (FD_ISSET(watch->fd, readfds) ? SCHEME_FD_READ : 0) |
+      (FD_ISSET(watch->fd, writefds) ? SCHEME_FD_WRITE : 0);
+    watch->ready &= watch->interest;
+    if (watch->ready) {
+      *tail = watch;
+      tail = &watch->ready_next;
+    }
+  }
+  *tail = NULL;
+  while ((watch = ready)) {
+    ready = watch->ready_next;
+    if (!watch->removed && (watch->ready & watch->interest)) {
+      uim_lisp result = uim_scm_call_with_guard(uim_scm_eof(),
+                                                watch->callback,
+                                                uim_scm_null());
+      if (result == uim_scm_eof()) {
+        fprintf(stderr, "uim-fep: Scheme callback failed for descriptor %d\n", watch->fd);
+        if (!watch->removed)
+          scheme_unwatch_fd(uim_scm_make_int(watch->fd));
+      }
+      dispatched = 1;
+    }
+    watch->ready = 0;
+    if (watch->removed)
+      free_scheme_fd_watch(watch);
+  }
+  return dispatched;
+}
+
+static void quit_scheme_fd_watches(void)
+{
+  while (scheme_fd_watches) {
+    struct scheme_fd_watch *watch = scheme_fd_watches;
+    scheme_fd_watches = watch->next;
+    free_scheme_fd_watch(watch);
+  }
+}
+#endif
